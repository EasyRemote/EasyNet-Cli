  "status_order": [
    "unsupported",
    "seam",
    "provider-backed",
    "cutover-ready"
  ],
  "status_definitions": {
    "unsupported": "No shipped public capability exists for this language.",
    "seam": "The public type and lifecycle contract exist, but no shipped execution provider exists.",
    "provider-backed": "One explicit provider implements the capability and executable shared evidence passes.",
    "cutover-ready": "First-class consumers use the provider and all lower-layer or product duplication has been deleted."
  },

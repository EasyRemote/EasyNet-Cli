{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/directory-page.schema.json",
  "title": "DirectoryPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "kind", "item_kind", "items", "next_cursor", "limit", "source", "metadata"],
  "properties": {
    "profile": {"const": "directory_identity"},
    "kind": {"type": "string", "enum": ["device_page", "agent_page", "ability_page"]},
    "item_kind": {"type": "string", "enum": ["device", "agent", "ability"]},
    "items": {"type": "array"},
    "next_cursor": {"type": ["string", "null"]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "source": {"const": "read_model"},
    "metadata": {"type": "object"}
  }
}

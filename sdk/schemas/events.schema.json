{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/events.schema.json",
  "title": "EventFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "stream",
    "kind",
    "event_id",
    "cursor",
    "resume_token",
    "occurred_unix_ms",
    "occurred_at",
    "subject_ref",
    "tenant_ref",
    "payload",
    "dropped_count",
    "reconnect_after_ms",
    "terminal",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "events"},
    "stream": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "sequence", "token"],
      "properties": {
        "stream": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "token": {"type": "string", "minLength": 1}
      }
    },
    "resume_token": {"type": "string", "minLength": 1},
    "occurred_unix_ms": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "minLength": 1},
    "subject_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ura", "role"],
          "properties": {
            "kind": {"const": "ura"},
            "ura": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "invocation_id"],
          "properties": {
            "kind": {"const": "invocation"},
            "invocation_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "tenant_ref": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "realm": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "payload": true,
    "dropped_count": {"type": "integer", "minimum": 0},
    "reconnect_after_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "terminal": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}

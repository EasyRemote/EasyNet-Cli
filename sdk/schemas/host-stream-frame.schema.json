{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/host-stream-frame.schema.json",
  "title": "HostStreamFrame",
  "type": "object",
  "additionalProperties": false,
  "required": ["frame_type", "seq", "value", "error", "terminal", "output_hash"],
  "properties": {
    "frame_type": {"type": "string", "enum": ["item", "error", "terminal"]},
    "seq": {"type": ["integer", "null"], "minimum": 0},
    "value": true,
    "error": {
      "oneOf": [
        {"$ref": "error.schema.json"},
        {"type": "null"}
      ]
    },
    "terminal": {
      "oneOf": [
        {"$ref": "host-stream-terminal-summary.schema.json"},
        {"type": "null"}
      ]
    },
    "output_hash": {"type": ["string", "null"]}
  },
  "oneOf": [
    {
      "properties": {
        "frame_type": {"const": "item"},
        "seq": {"type": "integer", "minimum": 0},
        "error": {"type": "null"},
        "terminal": {"type": "null"},
        "output_hash": {"type": "null"}
      }
    },
    {
      "properties": {
        "frame_type": {"const": "error"},
        "seq": {"type": "null"},
        "value": {"type": "null"},
        "error": {"$ref": "error.schema.json"},
        "terminal": {"type": "null"},
        "output_hash": {"type": "null"}
      }
    },
    {
      "properties": {
        "frame_type": {"const": "terminal"},
        "seq": {"type": "integer", "minimum": 0},
        "value": {"type": "null"},
        "error": {"type": "null"},
        "terminal": {"$ref": "host-stream-terminal-summary.schema.json"},
        "output_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/ability-package-manifest.schema.json",
  "title": "AbilityPackageManifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "namespace", "description", "input_schema"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "descriptor_version": {"type": "string"},
    "input_schema": {"type": "object"},
    "output_schema": {"type": ["object", "null"]},
    "exec": {"type": "object"}
  }
}

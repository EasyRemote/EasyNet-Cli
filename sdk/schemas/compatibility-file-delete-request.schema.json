{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/compatibility-file-delete-request.schema.json",
  "title": "CompatibilityFileDeleteRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["deleted"],
  "anyOf": [
    {"required": ["id"]},
    {"required": ["file_id"]},
    {"required": ["file_ref"]},
    {"required": ["resource_ref"]},
    {"required": ["resource_ura"]},
    {"required": ["content_hash"]}
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "file_id": {"type": "string", "minLength": 1},
    "file_ref": {"type": "string", "minLength": 1},
    "resource_ref": {"type": "string", "minLength": 1},
    "resource_ura": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "minLength": 1},
    "deleted": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}

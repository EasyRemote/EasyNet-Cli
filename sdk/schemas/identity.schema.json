{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/identity.schema.json",
  "title": "IdentityProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "valid", "profile", "components", "metadata"],
  "properties": {
    "kind": {"type": "string", "minLength": 1},
    "valid": {"type": "boolean"},
    "ura": {"type": "string", "minLength": 1},
    "realm": {"type": "string", "minLength": 1},
    "display_id": {"type": "string"},
    "descriptor_ref": {"type": "string", "minLength": 1},
    "ability_ura": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "components": {"type": "object"},
    "metadata": {"type": "object"}
  }
}

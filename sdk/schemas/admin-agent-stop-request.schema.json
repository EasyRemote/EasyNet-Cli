{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/admin-agent-stop-request.schema.json",
  "title": "AdminAgentStopRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["caller_ura", "callee_ura", "subject_ura", "descriptor_version", "nonce_base64", "causal_context"],
  "anyOf": [
    {"required": ["name"]},
    {"required": ["agent_ura"]}
  ],
  "properties": {
    "caller_ura": {"type": "string", "minLength": 1},
    "callee_ura": {"type": "string", "minLength": 1},
    "subject_ura": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "nonce_base64": {"type": "string", "minLength": 1},
    "causal_context": {"type": "object"},
    "name": {"type": "string", "minLength": 1},
    "agent_ura": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}

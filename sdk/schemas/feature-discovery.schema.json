{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/feature-discovery.schema.json",
  "title": "FeatureDiscovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["abi_version", "sdk_version", "profiles", "symbols", "axon_pb"],
  "properties": {
    "abi_version": {"type": "integer", "minimum": 0},
    "sdk_version": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_core",
        "receipt",
        "directory_identity",
        "publication",
        "host_binding",
        "mission",
        "events",
        "admin_gateway",
        "surface",
        "compatibility",
        "wrappers"
      ],
      "properties": {
        "runtime_core": {"type": "string", "enum": ["partial", "available", "cutover_ready"]},
        "receipt": {"type": "string"},
        "directory_identity": {"type": "string"},
        "publication": {"type": "string"},
        "host_binding": {"type": "string"},
        "mission": {"type": "string"},
        "events": {"type": "string"},
        "admin_gateway": {"type": "string"},
        "surface": {"type": "string"},
        "compatibility": {"type": "string"},
        "wrappers": {"type": "string"}
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daemon_lifecycle",
        "invocation_dispatch_v3",
        "typed_error_json",
        "receipt_fetch",
        "receipt_projection",
        "directory_identity_projection",
        "identity_signing_key_lifecycle",
        "directory_read_model",
        "directory_resolve",
        "directory_subscription_projection",
        "host_binding_codec",
        "publication_carriers",
        "mission_carriers",
        "mission_status_projection",
        "events_directory_stream",
        "events_session_stream",
        "admin_gateway_carriers",
        "admin_gateway_status_projection",
        "admin_device_session_projection",
        "admin_device_admin_projection",
        "surface_carriers",
        "surface_projection",
        "surface_health",
        "compatibility_carriers",
        "compatibility_projection",
        "compatibility_file_adapters",
        "wrapper_carriers",
        "wrapper_record_projection",
        "invocation_builder_handles",
        "invocation_handle_observation",
        "stream_bidi_lifecycle",
        "runtime_health",
        "runtime_diagnostics",
        "prepare_sign_submit"
      ],
      "properties": {
        "daemon_lifecycle": {"type": "boolean"},
        "invocation_dispatch_v3": {"type": "boolean"},
        "typed_error_json": {"type": "boolean"},
        "receipt_fetch": {"type": "boolean"},
        "receipt_projection": {"type": "boolean"},
        "directory_identity_projection": {"type": "boolean"},
        "identity_signing_key_lifecycle": {"type": "boolean"},
        "directory_read_model": {"type": "boolean"},
        "directory_resolve": {"type": "boolean"},
        "directory_subscription_projection": {"type": "boolean"},
        "host_binding_codec": {"type": "boolean"},
        "publication_carriers": {"type": "boolean"},
        "mission_carriers": {"type": "boolean"},
        "mission_status_projection": {"type": "boolean"},
        "events_directory_stream": {"type": "boolean"},
        "events_session_stream": {"type": "boolean"},
        "admin_gateway_carriers": {"type": "boolean"},
        "admin_gateway_status_projection": {"type": "boolean"},
        "admin_device_session_projection": {"type": "boolean"},
        "admin_device_admin_projection": {"type": "boolean"},
        "surface_carriers": {"type": "boolean"},
        "surface_projection": {"type": "boolean"},
        "surface_health": {"type": "boolean"},
        "compatibility_carriers": {"type": "boolean"},
        "compatibility_projection": {"type": "boolean"},
        "compatibility_file_adapters": {"type": "boolean"},
        "wrapper_carriers": {"type": "boolean"},
        "wrapper_record_projection": {"type": "boolean"},
        "invocation_builder_handles": {"type": "boolean"},
        "invocation_handle_observation": {"type": "boolean"},
        "stream_bidi_lifecycle": {"type": "boolean"},
        "runtime_health": {"type": "boolean"},
        "runtime_diagnostics": {"type": "boolean"},
        "prepare_sign_submit": {"type": "boolean"}
      }
    },
    "axon_pb": {"type": "boolean"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/feature-discovery.schema.json",
  "title": "FeatureDiscovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["abi_version", "sdk_version", "profiles", "symbols", "axon_pb"],
  "properties": {
    "abi_version": {"type": "integer", "minimum": 0},
    "sdk_version": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_core"],
      "properties": {
        "runtime_core": {"$ref": "#/$defs/profile_status"}
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_lifecycle",
        "generic_invocation",
        "typed_error_json",
        "invocation_builder_handles",
        "invocation_handle_observation",
        "stream_bidi_lifecycle",
        "runtime_health",
        "runtime_diagnostics",
        "prepare_sign_submit"
      ],
      "properties": {
        "runtime_lifecycle": {"type": "boolean"},
        "generic_invocation": {"type": "boolean"},
        "typed_error_json": {"type": "boolean"},
        "invocation_builder_handles": {"type": "boolean"},
        "invocation_handle_observation": {"type": "boolean"},
        "stream_bidi_lifecycle": {"type": "boolean"},
        "runtime_health": {"type": "boolean"},
        "runtime_diagnostics": {"type": "boolean"},
        "prepare_sign_submit": {"type": "boolean"}
      }
    },
    "axon_pb": {"type": "boolean"}
  },
  "$defs": {
    "profile_status": {
      "type": "string",
      "enum": ["unsupported", "seam", "provider-backed", "cutover-ready"]
    }
  }
}

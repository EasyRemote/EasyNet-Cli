{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/resource-ref.schema.json",
  "title": "ResourceRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_ura",
    "owner_ura",
    "namespace",
    "capability",
    "expires_unix_ms",
    "revision"
  ],
  "properties": {
    "resource_ura": {"type": "string", "minLength": 1},
    "owner_ura": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "enum": ["fs"]},
    "display_path": {"type": "string"},
    "capability": {"type": "string", "enum": ["list", "stat", "read", "write"]},
    "expires_unix_ms": {"type": "integer"},
    "revision": {"type": "string", "minLength": 1}
  }
}

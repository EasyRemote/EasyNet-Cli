{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/receipt-ref.schema.json",
  "title": "ReceiptRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_ura", "receipt_hash_hex"],
  "properties": {
    "receipt_ura": {"type": "string", "minLength": 1},
    "receipt_hash_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "invocation_id": {"type": "string", "minLength": 1},
    "prev_receipt_hash_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object"}
  }
}

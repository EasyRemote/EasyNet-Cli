{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/surface-page-page.schema.json",
  "title": "SurfacePagePage",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "kind", "item_kind", "items", "next_cursor", "limit", "source", "metadata"],
  "properties": {
    "profile": {"const": "surface"},
    "kind": {"const": "surface_page_page"},
    "item_kind": {"const": "page_record"},
    "items": {"type": "array", "items": {"$ref": "surface-page.schema.json"}},
    "next_cursor": {"type": ["string", "null"]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "source": {"const": "pages_read_model"},
    "metadata": {"type": "object"}
  }
}

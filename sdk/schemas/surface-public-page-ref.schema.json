{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/surface-public-page-ref.schema.json",
  "title": "SurfacePublicPageRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "kind", "page_id", "owner_ura", "surface_ref", "public_ref", "route_kind", "metadata"],
  "properties": {
    "profile": {"const": "surface"},
    "kind": {"const": "public_page_ref"},
    "page_id": {"type": "string", "minLength": 1},
    "owner_ura": {"type": "string", "minLength": 1},
    "surface_ref": {"type": "string", "minLength": 1},
    "public_ref": {"type": "string", "minLength": 1},
    "route_kind": {"const": "hub_web"},
    "metadata": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/admin-device-session-create-request.schema.json",
  "title": "CreateDeviceSessionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["caller_ura", "callee_ura", "subject_ura", "descriptor_version", "nonce_base64", "causal_context", "device_ura", "hub_ura", "session_kind"],
  "properties": {
    "caller_ura": {"type": "string", "minLength": 1},
    "callee_ura": {"type": "string", "minLength": 1},
    "subject_ura": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "nonce_base64": {"type": "string", "minLength": 1},
    "causal_context": {"type": "object"},
    "device_ura": {"type": "string", "minLength": 1},
    "hub_ura": {"type": "string", "minLength": 1},
    "session_kind": {"type": "string", "minLength": 1},
    "expires_unix_ms": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"}
  }
}

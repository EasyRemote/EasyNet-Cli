{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/events-session-subscription-request.schema.json",
  "title": "EventsSessionSubscriptionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caller_ura",
    "callee_ura",
    "subject_ura",
    "descriptor_version",
    "nonce_base64",
    "causal_context",
    "stream",
    "session_id"
  ],
  "properties": {
    "caller_ura": {"type": "string", "minLength": 1},
    "callee_ura": {"type": "string", "minLength": 1},
    "subject_ura": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "nonce_base64": {"type": "string", "minLength": 1},
    "causal_context": {"type": "object"},
    "stream": {"const": "session"},
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s]+$"
        }
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$"
    },
    "resume_cursor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stream", "sequence"],
          "properties": {
            "stream": {"const": "session"},
            "sequence": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "metadata": {"type": "object"}
  },
  "not": {
    "required": ["session_ura"]
  }
}

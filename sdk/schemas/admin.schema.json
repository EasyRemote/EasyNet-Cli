{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/admin.schema.json",
  "title": "AdminRecord",
  "type": "object",
  "additionalProperties": true,
  "required": ["profile", "kind", "state"],
  "properties": {
    "profile": {"const": "admin_gateway"},
    "kind": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "device_ura": {"type": ["string", "null"]},
    "agent_ura": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}

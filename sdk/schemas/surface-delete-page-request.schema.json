{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/surface-delete-page-request.schema.json",
  "title": "SurfaceDeletePageRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caller_ura",
    "callee_ura",
    "subject_ura",
    "descriptor_version",
    "nonce_base64",
    "causal_context",
    "project_id"
  ],
  "properties": {
    "caller_ura": {"type": "string", "minLength": 1},
    "callee_ura": {"type": "string", "minLength": 1},
    "subject_ura": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "nonce_base64": {"type": "string", "minLength": 1},
    "causal_context": {"type": "object"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "metadata": {"type": "object"}
  }
}

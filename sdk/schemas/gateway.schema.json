{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/gateway.schema.json",
  "title": "GatewayStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "gateway_id",
    "ready",
    "state",
    "process_live",
    "control_ready",
    "runtime_ready",
    "directory_ready",
    "trust_ready",
    "public_listener_ready",
    "listeners",
    "identity",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "admin_gateway"},
    "gateway_id": {"type": "string", "minLength": 1},
    "ready": {"type": "boolean"},
    "state": {"type": "string", "minLength": 1},
    "process_live": {"type": "boolean"},
    "control_ready": {"type": "boolean"},
    "runtime_ready": {"type": "boolean"},
    "directory_ready": {"type": "boolean"},
    "trust_ready": {"type": "boolean"},
    "public_listener_ready": {"type": "boolean"},
    "listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "endpoint", "ready", "public"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "minLength": 1},
          "ready": {"type": "boolean"},
          "public": {"type": "boolean"}
        }
      }
    },
    "identity": {"type": ["object", "null"]},
    "metadata": {"type": "object"}
  }
}

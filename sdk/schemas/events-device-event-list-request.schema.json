{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/events-device-event-list-request.schema.json",
  "title": "EventsDeviceEventListRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caller_ura",
    "callee_ura",
    "subject_ura",
    "descriptor_version",
    "nonce_base64",
    "causal_context",
    "device_ura"
  ],
  "properties": {
    "caller_ura": {"type": "string", "minLength": 1},
    "callee_ura": {"type": "string", "minLength": 1},
    "subject_ura": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "nonce_base64": {"type": "string", "minLength": 1},
    "causal_context": {"type": "object"},
    "device_ura": {"type": "string", "minLength": 1},
    "cursor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stream", "sequence"],
          "properties": {
            "stream": {"const": "device"},
            "sequence": {"type": "integer", "minimum": 0},
            "token": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "metadata": {"type": "object"}
  }
}

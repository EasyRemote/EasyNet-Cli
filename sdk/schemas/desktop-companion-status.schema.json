{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/desktop-companion-status.schema.json",
  "title": "DesktopCompanionStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "package_id",
    "package_version",
    "display_name",
    "platform",
    "desired_state",
    "supervisor_state",
    "observed_state",
    "projected_state",
    "boot_policy",
    "stop_policy",
    "health",
    "pid",
    "version",
    "last_seen_unix_ms",
    "launch_method",
    "error",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "desktop_companion"},
    "kind": {"const": "desktop_companion_status"},
    "package_id": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "platform": {"enum": ["macos", "windows", "linux", "unknown"]},
    "desired_state": {"enum": ["enabled", "disabled"]},
    "supervisor_state": {
      "enum": [
        "unsupported_platform",
        "unsupported_session",
        "not_installed",
        "installed_disabled",
        "installed_enabled",
        "install_error",
        "enable_error",
        "disable_error"
      ]
    },
    "observed_state": {
      "enum": [
        "unknown",
        "not_running",
        "starting",
        "running",
        "stale",
        "exited",
        "version_mismatch",
        "health_error"
      ]
    },
    "projected_state": {
      "enum": [
        "disabled",
        "unsupported_platform",
        "unsupported_session",
        "not_installed",
        "installed_disabled",
        "ready_stopped",
        "starting",
        "running",
        "stale",
        "error"
      ]
    },
    "boot_policy": {"enum": ["manual", "ensure_running_after_daemon_ready"]},
    "stop_policy": {
      "enum": ["keep_running", "stop_on_runtime_stop", "stop_on_plugin_disable"]
    },
    "health": {"enum": ["process_name", "status_file", "local_ipc"]},
    "pid": {"type": ["integer", "null"], "minimum": 0},
    "version": {"type": ["string", "null"]},
    "last_seen_unix_ms": {"type": ["integer", "null"], "minimum": 0},
    "launch_method": {"type": ["string", "null"]},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "metadata": {"type": "object"}
  }
}

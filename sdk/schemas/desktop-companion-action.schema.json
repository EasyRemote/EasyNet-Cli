{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/desktop-companion-action.schema.json",
  "title": "DesktopCompanionActionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "package_id",
    "action",
    "status_before",
    "status_after",
    "changed",
    "error",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "desktop_companion"},
    "kind": {"const": "desktop_companion_action_result"},
    "package_id": {"type": "string", "minLength": 1},
    "action": {
      "enum": [
        "status",
        "install",
        "remove",
        "enable",
        "disable",
        "start",
        "stop",
        "restart",
        "reconcile"
      ]
    },
    "status_before": {
      "anyOf": [
        {"$ref": "desktop-companion-status.schema.json"},
        {"type": "null"}
      ]
    },
    "status_after": {
      "anyOf": [
        {"$ref": "desktop-companion-status.schema.json"},
        {"type": "null"}
      ]
    },
    "changed": {"type": "boolean"},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "metadata": {"type": "object"}
  }
}

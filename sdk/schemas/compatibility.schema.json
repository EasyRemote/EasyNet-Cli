{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/compatibility.schema.json",
  "title": "CompatibilityResult",
  "type": "object",
  "additionalProperties": true,
  "required": ["profile", "kind", "metadata"],
  "properties": {
    "profile": {"const": "compatibility"},
    "kind": {
      "enum": [
        "model_page",
        "model",
        "chat_completion",
        "chat_completion_stream",
        "chat_completion_chunk"
      ]
    },
    "object": {"type": ["string", "null"]},
    "id": {"type": ["string", "null"]},
    "created": {"type": ["integer", "null"], "minimum": 0},
    "model": {"type": ["string", "null"]},
    "ability_ref": {"type": ["string", "null"]},
    "data": {"type": "array"},
    "items": {"type": "array"},
    "choices": {"type": "array"},
    "usage": {"type": ["object", "null"]},
    "stream": {"type": "boolean"},
    "done_sentinel": {"type": "string"},
    "next_cursor": true,
    "metadata": {"type": "object"}
  }
}

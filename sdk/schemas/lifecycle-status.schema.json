{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/lifecycle-status.schema.json",
  "title": "DaemonLifecycleStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "control_ready", "invocation_ready"],
  "properties": {
    "state": {"type": "string", "minLength": 1},
    "control_ready": {"type": "boolean"},
    "invocation_ready": {"type": "boolean"},
    "pid": {"type": ["integer", "null"], "minimum": 0},
    "endpoints": {"type": "object"},
    "error": {"$ref": "error.schema.json"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/terminal.schema.json",
  "title": "TerminalSessionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "kind", "session_id", "owner_ura", "state"],
  "properties": {
    "profile": {"const": "wrappers"},
    "kind": {"const": "terminal_session"},
    "session_id": {"type": "string", "minLength": 1},
    "owner_ura": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "terminal_ref": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}

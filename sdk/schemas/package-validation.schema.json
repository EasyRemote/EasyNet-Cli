{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/package-validation.schema.json",
  "title": "PackageValidation",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "kind", "valid", "package_path", "manifest_path", "manifest_hash", "manifest", "errors", "metadata"],
  "properties": {
    "profile": {"const": "publication"},
    "kind": {"const": "package_validation"},
    "valid": {"type": "boolean"},
    "package_path": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "wire_key", "descriptor_version", "description", "exec_kind", "timeout_seconds", "input_schema", "output_schema"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "wire_key": {"type": "string", "minLength": 1},
        "descriptor_version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "exec_kind": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": ["integer", "null"], "minimum": 0},
        "input_schema": {"type": "object"},
        "output_schema": {"type": ["object", "null"]}
      }
    },
    "errors": {"type": "array"},
    "metadata": {"type": "object"}
  }
}

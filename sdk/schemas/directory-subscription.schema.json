{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/directory-subscription.schema.json",
  "title": "DirectorySubscription",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "stream",
    "state",
    "cursor",
    "resume_token",
    "drop_count",
    "events",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "directory_identity"},
    "kind": {"const": "directory_subscription"},
    "stream": {"const": "directory"},
    "state": {
      "enum": ["Opening", "CatchingUp", "Live", "Resuming", "Closed", "Failed"]
    },
    "cursor": {"$ref": "#/$defs/cursor"},
    "resume_token": {"type": "string", "pattern": "^directory:[0-9]+$"},
    "drop_count": {"type": "integer", "minimum": 0},
    "events": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/event"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "sequence", "token"],
      "properties": {
        "stream": {"const": "directory"},
        "sequence": {"type": "integer", "minimum": 0},
        "token": {"type": "string", "pattern": "^directory:[0-9]+$"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "stream",
        "kind",
        "event_id",
        "phase",
        "cursor",
        "resume_token",
        "terminal",
        "metadata"
      ],
      "properties": {
        "profile": {"const": "directory_identity"},
        "stream": {"const": "directory"},
        "kind": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "item_kind": {"type": "string", "minLength": 1},
        "item": {"type": "object"},
        "cursor": {"$ref": "#/$defs/cursor"},
        "resume_token": {"type": "string", "pattern": "^directory:[0-9]+$"},
        "terminal": {"type": "boolean"},
        "metadata": {"type": "object"}
      }
    }
  }
}

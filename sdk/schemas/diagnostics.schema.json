{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/diagnostics.schema.json",
  "title": "DiagnosticsReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "state",
    "ready",
    "version",
    "abi_version",
    "control_endpoint",
    "invocation_endpoint",
    "checks",
    "diagnostics"
  ],
  "properties": {
    "profile": {"const": "health"},
    "kind": {"const": "diagnostics_report"},
    "state": {"type": "string", "minLength": 1},
    "ready": {"type": "boolean"},
    "version": {"type": "string", "minLength": 1},
    "abi_version": {"type": "integer", "minimum": 0},
    "control_endpoint": {"type": "string"},
    "invocation_endpoint": {"type": ["string", "null"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ready", "message"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "ready": {"type": "boolean"},
          "message": {"type": ["string", "null"]}
        }
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}

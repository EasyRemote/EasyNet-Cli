{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/surface-manifest.schema.json",
  "title": "SurfaceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "kind", "page_id", "owner_ura", "surface_ref", "public_ref", "page", "entrypoint", "metadata"],
  "properties": {
    "profile": {"const": "surface"},
    "kind": {"const": "surface_manifest"},
    "page_id": {"type": "string", "minLength": 1},
    "owner_ura": {"type": "string", "minLength": 1},
    "surface_ref": {"type": "string", "minLength": 1},
    "public_ref": {"type": "string", "minLength": 1},
    "page": {"$ref": "surface-page.schema.json"},
    "entrypoint": {"type": "object"},
    "metadata": {"type": "object"}
  }
}

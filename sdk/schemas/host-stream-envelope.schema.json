{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/host-stream-envelope.schema.json",
  "title": "HostStreamEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["request"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fn", "args", "call_id", "caller"],
      "properties": {
        "fn": {"type": "string", "minLength": 1},
        "args": true,
        "call_id": {"type": "string", "minLength": 1},
        "caller": {"type": "string", "minLength": 1}
      }
    }
  }
}

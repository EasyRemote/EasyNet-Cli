{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/mission-event-page.schema.json",
  "title": "MissionEventPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "mission_id",
    "cursor_sequence",
    "has_more",
    "dropped_count",
    "events",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "mission"},
    "kind": {"const": "mission_event_page"},
    "mission_id": {"type": "string", "minLength": 1},
    "cursor_sequence": {"type": "integer", "minimum": 0},
    "next_cursor_sequence": {"type": ["integer", "null"], "minimum": 0},
    "has_more": {"type": "boolean"},
    "dropped_count": {"type": "integer", "minimum": 0},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "kind",
          "mission_id",
          "sequence",
          "event_type",
          "occurred_unix_ms",
          "terminal",
          "payload",
          "receipt",
          "metadata"
        ],
        "properties": {
          "profile": {"const": "mission"},
          "kind": {"const": "mission_event"},
          "mission_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 0},
          "event_type": {"type": "string", "minLength": 1},
          "occurred_unix_ms": {"type": "integer", "minimum": 0},
          "terminal": {"type": "boolean"},
          "payload": {"type": "object"},
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "receipt_ura": {"type": "string", "minLength": 1},
              "receipt_hash": {"type": "string", "minLength": 1},
              "head_receipt_hash": {"type": ["string", "null"]}
            }
          },
          "metadata": {"type": "object"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/surface-health.schema.json",
  "title": "SurfaceHealth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "state",
    "ready",
    "owner_ura",
    "surface_ref",
    "descriptor_ref",
    "descriptor_version",
    "page_count",
    "checks",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "surface"},
    "kind": {"const": "surface_health"},
    "state": {"type": "string", "minLength": 1},
    "ready": {"type": "boolean"},
    "owner_ura": {"type": "string", "minLength": 1},
    "surface_ref": {"type": "string", "minLength": 1},
    "descriptor_ref": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "ready", "message", "latency_ms", "metadata"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "ready": {"type": "boolean"},
          "message": {"type": ["string", "null"]},
          "latency_ms": {"type": "integer", "minimum": 0},
          "metadata": {"type": "object"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/authority.schema.json",
  "title": "Authority",
  "oneOf": [
    {"$ref": "#/$defs/signing_boundary"},
    {"$ref": "#/$defs/metadata_conformance"}
  ],
  "$defs": {
    "signing_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["caller_presigned", "local_daemon_signing", "unsigned_rejected"]},
        "signer_id": {"type": ["string", "null"]},
        "policy": {"type": "string"},
        "proof": {"type": ["object", "null"]}
      }
    },
    "metadata_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_metadata_key",
        "session_authority_metadata_key",
        "delegation_metadata_value",
        "session_authority_metadata_value",
        "expected_delegation",
        "expected_session_authority"
      ],
      "properties": {
        "delegation_metadata_key": {"const": "x-easynet-delegation"},
        "session_authority_metadata_key": {"const": "x-easynet-session-authority"},
        "delegation_metadata_value": {"type": "string", "minLength": 1},
        "session_authority_metadata_value": {"type": "string", "minLength": 1},
        "expected_delegation": {"$ref": "#/$defs/delegation_projection"},
        "expected_session_authority": {"$ref": "#/$defs/session_authority_projection"}
      }
    },
    "delegation_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_ura",
        "subject_ura",
        "caller_ura",
        "audience",
        "scopes",
        "issued_at_ms",
        "expires_at_ms",
        "signature_base64"
      ],
      "properties": {
        "issuer_ura": {"type": "string", "minLength": 1},
        "subject_ura": {"type": "string", "minLength": 1},
        "caller_ura": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "issued_at_ms": {"type": "integer", "minimum": 0},
        "expires_at_ms": {"type": "integer", "minimum": 1},
        "signature_base64": {"type": "string", "minLength": 1}
      }
    },
    "session_authority_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_ura",
        "session_id",
        "session_owner_user_id",
        "creator_principal_id",
        "callee_ura",
        "subject_ura",
        "audience",
        "scopes",
        "allowed_actions",
        "allowed_followup_abilities",
        "issued_at_ms",
        "expires_at_ms",
        "signature_base64"
      ],
      "properties": {
        "issuer_ura": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "session_owner_user_id": {"type": "string", "minLength": 1},
        "creator_principal_id": {"type": "string", "minLength": 1},
        "callee_ura": {"type": "string", "minLength": 1},
        "subject_ura": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_followup_abilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "issued_at_ms": {"type": "integer", "minimum": 0},
        "expires_at_ms": {"type": "integer", "minimum": 1},
        "signature_base64": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/receipt-fetch-request.schema.json",
  "title": "ReceiptFetchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["caller_ura", "callee_ura", "subject_ura", "descriptor_version", "nonce_base64", "causal_context"],
  "oneOf": [
    {"required": ["invocation_ura"]},
    {"required": ["request_id"]},
    {"required": ["trace_id"]}
  ],
  "properties": {
    "caller_ura": {"type": "string", "minLength": 1},
    "callee_ura": {"type": "string", "minLength": 1},
    "subject_ura": {"type": "string", "minLength": 1},
    "descriptor_version": {"type": "string", "minLength": 1},
    "nonce_base64": {"type": "string", "minLength": 1},
    "causal_context": {"type": "object"},
    "invocation_ura": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}

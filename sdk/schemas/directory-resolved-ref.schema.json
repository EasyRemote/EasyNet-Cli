{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/directory-resolved-ref.schema.json",
  "title": "DirectoryResolvedRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "answer_kind",
    "query_name",
    "canonical_name",
    "owner_ura",
    "ability_ura",
    "route_ura",
    "next_hop",
    "selected_route",
    "route_candidates",
    "records",
    "negative",
    "release_profile",
    "authority",
    "cache_policy",
    "metadata"
  ],
  "properties": {
    "profile": {"const": "directory_identity"},
    "kind": {"const": "resolved_ref"},
    "answer_kind": {"type": "string", "minLength": 1},
    "query_name": {"type": ["string", "null"]},
    "canonical_name": {"type": ["string", "null"]},
    "owner_ura": {"type": ["string", "null"]},
    "ability_ura": {"type": ["string", "null"]},
    "route_ura": {"type": ["string", "null"]},
    "next_hop": {"type": ["object", "null"]},
    "selected_route": {"type": ["object", "null"]},
    "route_candidates": {"type": "array"},
    "records": {"type": "array"},
    "negative": {"type": ["object", "null"]},
    "release_profile": {"type": ["string", "null"]},
    "authority": {"type": ["object", "null"]},
    "cache_policy": {"type": ["object", "null"]},
    "metadata": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynet.run/sdk/schemas/host-stream-binding.schema.json",
  "title": "HostStreamBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "descriptor_ref",
    "endpoint",
    "frame_schema",
    "cleanup",
    "timeout_ms",
    "readiness",
    "lifecycle",
    "metadata"
  ],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "descriptor_ref": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "frame_schema": {"type": "string", "const": "host-stream-frame.schema.json"},
    "cleanup": {"type": "object"},
    "timeout_ms": {"type": ["integer", "null"], "minimum": 0},
    "readiness": {"type": "object"},
    "lifecycle": {"type": "object"},
    "metadata": {"type": "object"}
  }
}

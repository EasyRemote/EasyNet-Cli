# macOS BSD sed writes `<name>-e` backups when `-i ''` is mis-used.
*-e

# LaTeX auxiliary build products — keep .tex / .pdf only.
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Claude Code project-local sidecar.
.claude/

# Local architecture/indexing cache.
.codegraph/

# SDK language dependency/build sidecars generated by local conformance runs.
sdk/conformance/__pycache__/
sdk/node/node_modules/
sdk/python/.pytest_cache/
sdk/python/.tmp/
sdk/python/*.egg-info/
sdk/java/target/
sdk/swift/.build/
sdk/rust/provider/runtime/pluginexec/target/


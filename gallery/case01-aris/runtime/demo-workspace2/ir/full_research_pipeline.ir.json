{
  "name": "case01-aris-full-research-pipeline",
  "steps": [
    {
      "step_id": "bootstrap",
      "step_name": "bootstrap",
      "ability": "aris.bootstrap",
      "target": {
        "kind": "device",
        "node_id": "aris-host"
      },
      "static_arguments": {
        "direction": "factorized gap in discrete diffusion LMs",
        "project": "case01-aris",
        "stage": "bootstrap"
      },
      "output_binding": "bootstrap",
      "timeout_seconds": 30,
      "max_retries": 0,
      "on_failure": "continue",
      "optional": false,
      "content_type": "application/json"
    },
    {
      "step_id": "__anon_2",
      "step_name": "__anon_2",
      "ability": "aris.metrics_ping",
      "target": {
        "kind": "device",
        "node_id": "aris-host"
      },
      "static_arguments": {
        "event": "case01_full_pipeline_completed"
      },
      "timeout_seconds": 0,
      "max_retries": 0,
      "on_failure": "continue",
      "optional": true,
      "content_type": "application/json"
    },
    {
      "step_id": "idea_report",

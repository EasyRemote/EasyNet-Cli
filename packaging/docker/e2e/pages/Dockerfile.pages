# EasyNet-Cli — Docker E2E image for the Pages reference system
# ==============================================================
#
# File: packaging/docker/e2e/pages/Dockerfile.pages
# Description: minimal Linux container that runs the easynet daemon
#              with the Pages listener enabled, plus curl + strace +
#              python3 for the harness in `pages-mvp.sh`.
#
# Layout:
#   /usr/local/bin/easynet         CLI binary (built outside, COPY'd in)
#   /usr/local/bin/easynet-daemon  daemon binary (built outside, COPY'd in)
#   /opt/site/                     fixture folder published in tests
#   /opt/harness/                  test harness scripts
#
# Build (from repo root):
#   cargo build -p easynet --release --features axon-pb \
#       --target x86_64-unknown-linux-musl \
#       --bin easynet --bin easynet-daemon
#   docker build \
#       -f packaging/docker/e2e/pages/Dockerfile.pages \
#       -t easynet-pages-e2e \
#       --build-arg BIN_DIR=target/x86_64-unknown-linux-musl/release \
#       .
#
# Conformance: RFC-006-B v0.6 §6.3 Matrix C; harness = D1-D10.

FROM debian:12-slim

ARG BIN_DIR=target/release

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        jq \
        strace \
        procps \
        python3 \
        # net-tools optional for `lsof -i` style checks
        net-tools \
    && rm -rf /var/lib/apt/lists/*

# Pre-baked fixture folder: the canonical hello-world.html + style.css
# the demo expects. The harness creates additional fixtures (dotfile,
# symlink) at runtime.
RUN mkdir -p /opt/site
COPY packaging/docker/e2e/pages/fixtures/hello-world.html /opt/site/hello-world.html
COPY packaging/docker/e2e/pages/fixtures/style.css       /opt/site/style.css

# Daemon + CLI binaries (built on the host with cargo-musl).
COPY ${BIN_DIR}/easynet          /usr/local/bin/easynet
COPY ${BIN_DIR}/easynet-daemon   /usr/local/bin/easynet-daemon

# Harness sits on the image so a `docker exec ... pages-mvp.sh` runs
# every check without the host shipping anything.
RUN mkdir -p /opt/harness
COPY packaging/docker/e2e/pages/pages-mvp.sh /opt/harness/pages-mvp.sh
COPY packaging/docker/e2e/pages/entrypoint.sh /opt/harness/entrypoint.sh
RUN chmod +x /opt/harness/pages-mvp.sh /opt/harness/entrypoint.sh

# Symlink fixture for D6 (M7 in unit matrix) — Docker COPY does not
# preserve symlinks reliably across build contexts, so the harness
# creates the symlink at runtime rather than at image-build time.

# Pages listener envs. Operators override via `docker run -e ...`.
ENV EASYNET_PAGES_PORT=8787
ENV EASYNET_PAGES_USER=alice
ENV EASYNET_PAGES_REALM=easynet.run

EXPOSE 8787

ENTRYPOINT ["/opt/harness/entrypoint.sh"]
